# -----------------------------
# Application mode
# -----------------------------
APP_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret
JWT_SECRET=change-this-too-or-keep-same-as-secret
SESSION_COOKIE_SECURE=1
REQUIRE_EXTERNAL_DB=1

# -----------------------------
# Auth users (format: USERX=username:bcrypt_hash)
# -----------------------------
USER1=admin:$2b$12$replace_with_bcrypt_hash
ADMIN_USERS=admin

# -----------------------------
# Network / server
# -----------------------------
HOST=0.0.0.0
PORT=10000
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
JWT_EXPIRES_SECONDS=28800

# -----------------------------
# Gunicorn tuning (baseline for ~10k/day)
# -----------------------------
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# -----------------------------
# Database (recommended: Postgres)
# -----------------------------
DATABASE_URL=postgresql://username:password@host:5432/dbname
DB_SSLMODE=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------
# Supabase Storage (optional, recommended on Render)
# -----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=sale-orders

# -----------------------------
# Local fallback paths
# -----------------------------
DATABASE_FILE=/var/data/order_counter.db
UPLOAD_FOLDER=/var/data/uploads
REPORT_FOLDER=/var/data/reports
MAX_CONTENT_LENGTH=16777216

# -----------------------------
# Logging
# -----------------------------
ENABLE_FILE_LOGGING=0
LOG_FILE=/var/log/sale-order-api/app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# -----------------------------
# Health / readiness
# -----------------------------
READINESS_CHECK_DB=1
