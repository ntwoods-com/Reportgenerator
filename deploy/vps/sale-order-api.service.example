[Unit]
Description=Sale Order API (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sale-order
EnvironmentFile=/opt/sale-order/.env.production
ExecStart=/opt/sale-order/.venv/bin/gunicorn --config /opt/sale-order/gunicorn.conf.py wsgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
